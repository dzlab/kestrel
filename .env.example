# OpenAI-compatible API base URL. Kestrel appends /chat/completions.
KESTREL_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# Optional bearer token. Keep this empty in the example and set it only in .env or your shell.
KESTREL_MODEL_API_KEY=
KESTREL_MODEL_NAME=kestrel

# Workspace and durable local state.
KESTREL_WORKSPACE=.
KESTREL_DATA_DIR=~/.kestrel
# Relative paths are resolved under KESTREL_DATA_DIR.
KESTREL_DB=kestrel.sqlite

# Bounded execution defaults.
KESTREL_MODEL_TIMEOUT_MS=30000
KESTREL_MAX_TURNS=12
KESTREL_MAX_TOOL_CALLS=24
KESTREL_MAX_TOKENS=32000
KESTREL_RUN_TIMEOUT_MS=120000
KESTREL_TOOL_TIMEOUT_MS=30000
KESTREL_CONTEXT_BYTES=32768
