[0.319447, "o", "[exit 1]\r\n"]
[0.319493, "o", "\r\n$ mise exec -- bun run src/cli/main.ts deny demo-call\r\n"]
[0.355378, "o", "approval or tool call not found: demo-call\r\n"]
[0.358124, "o", "[exit 1]\r\n"]
[0.358187, "o", "\r\n$ mise exec -- bun run src/cli/main.ts memory list 5\r\n"]
[0.394995, "o", "[]\r\n"]
[0.39635, "o", "\r\n$ mise exec -- bun run src/cli/main.ts memory search kestrel\r\n"]
[0.433729, "o", "[]\r\n"]
