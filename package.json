{
  "name": "kestrel",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "kestrel": "src/cli/main.ts"
  },
  "files": [
    "src/",
    "ui/dist/",
    "README.md",
    "docs/architecture.md",
    "docs/security.md",
    "docs/dependency-licenses.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "dev": "bun run src/cli/main.ts",
    "cli": "bun run src/cli/main.ts",
    "smoke": "bun run src/cli/main.ts --help",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "prepack": "bun run ui:build",
    "diff:check": "git diff --check",
    "check": "bun run typecheck && bun test && bun run diff:check"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  }
}
